# Copy to .env.local (local) or set these in the hosting dashboard (production).
# Never commit real values.

# Supabase: Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only; bypasses RLS. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Any long random string (e.g. `openssl rand -hex 32`); signs the OAuth state parameter.
OAUTH_STATE_SECRET=

# Google Cloud Console: OAuth client (Web application)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Production: https://<your-domain>/api/connections/youtube/callback (must also be an
# Authorized redirect URI in the Google client)
GOOGLE_REDIRECT_URI=

# TikTok for Developers app
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# Production: https://<your-domain>/api/connections/tiktok/callback (must also be a
# Redirect URI in the TikTok app)
TIKTOK_REDIRECT_URI=

# Google AI Studio, paid tier (see doc/CLAUDE.md section 10)
GEMINI_API_KEY=

# Daily sync scheduler secret (random string). Without it /api/sync/all answers 404.
CRON_SECRET=

# Shown on /privacy, /terms and the site footer
NEXT_PUBLIC_CONTACT_EMAIL=